<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helper="clr-namespace:BagrutProject_2027.Helper"
             x:Class="BagrutProject_2027.Views.LoginPage"
             BackgroundColor="#0D0D0D"
             Title="LoginPage">

    <ContentPage.Resources>
        <!--i added styles that go with my project-->
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#1A1A1A" />
            <Setter Property="TextColor" Value="#39FF14" />
            <Setter Property="PlaceholderColor" Value="#557755" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#39FF14" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#39FF14" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>
        
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout 
        VerticalOptions="Center" 
        Padding="30" 
        Spacing="14"      
        MaximumWidthRequest="420">

        <Label 
            Text="Welcome Back" 
            FontSize="34" 
            FontAttributes="Bold"
           TextColor="White" 
            HorizontalOptions="Center" />
        
        <Label 
            Text="Login to your account" 
            FontSize="16"
           TextColor="#557755" 
            HorizontalOptions="Center" 
            Margin="0,0,0,20" />

        <!-- Email -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Label 
                Grid.Column="0" 
                FontFamily="MaterialIcons" 
                FontSize="26"
                Text="{x:Static helper:IconFonts.Email}"
                TextColor="#39FF14" VerticalOptions="Center" />

            <Entry Grid.Column="1"
                Placeholder="Email"
                Keyboard="Email"
                Text="{Binding Email, Mode=TwoWay}" />
        </Grid>
        
        <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10">
            <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
           Text="{x:Static helper:IconFonts.Lock}"
           TextColor="#39FF14" VerticalOptions="Center" />
            
            <Entry 
                Grid.Column="1" 
                x:Name="PasswordEntry" 
                Placeholder="Password" 
                IsPassword="True" />

            <!--BackgroundColor="#1A1A1A",Text="{x:Static helper:IconFonts.Visibility},FontFamily="MaterialIcons" FontSize="26" "-->
            <Button Grid.Column="2"
                Text="{Binding PasswordToggleText}"
                Command="{Binding TogglePasswordCommand}"
                TextColor="#39FF14"
                BackgroundColor="Transparent"
                Padding="6,0" />
        </Grid>

        <!-- Error and success messages -->
        <Label
            Text="{Binding Message}"
            TextColor="{Binding MessageColor}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <!-- Login -->
        <Button
            Text="Login"
            Style="{StaticResource MainButton}"
            Command="{Binding LoginCommand}" />

        <!-- Navigate to registration -->
        <Button
            Text="Don't have an account? Register"
            Style="{StaticResource LinkButton}"
            Command="{Binding GoToRegisterCommand}" />
        
    </VerticalStackLayout>
</ContentPage>