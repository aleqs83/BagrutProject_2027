<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BagrutProject_2027.Views.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout Padding="24" Spacing="10">
        <Label Text="Login" FontSize="28" />

        <Entry x:Name="EmailEntry" Placeholder="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

        <!-- one label for all messages (errors and success) -->
        <Label x:Name="MessageLabel" />

        <Button Text="Login" Clicked="OnLoginClicked" />
        <Button Text="Go to Register" Clicked="OnRegisterClicked" />
    </VerticalStackLayout>
</ContentPage>