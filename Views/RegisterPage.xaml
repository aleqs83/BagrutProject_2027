<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helper="clr-namespace:BagrutProject_2027.Helper"
             x:Class="BagrutProject_2027.Views.RegisterPage"
             BackgroundColor="#0D0D0D"
             Title="RegisterPage">

    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#1A1A1A" />
            <Setter Property="TextColor" Value="#39FF14" />
            <Setter Property="PlaceholderColor" Value="#557755" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#39FF14" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#39FF14" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12" MaximumWidthRequest="420">

            <Label Text="Create Account" FontSize="34" FontAttributes="Bold"
                TextColor="White" HorizontalOptions="Center" Margin="0,20,0,10" />

            
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><!--username entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Person_add_alt}"
                       TextColor="#39FF14" VerticalOptions="Center" />

                <Entry Grid.Column="1"
                    Placeholder="Username"
                    Text="{Binding Name, Mode=TwoWay}"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><!--EMAIL entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Email}"
                       TextColor="#39FF14" VerticalOptions="Center" />

                <Entry Grid.Column="1"
                    Placeholder="Email (name@gmail.com)"
                    Keyboard="Email"
                    Text="{Binding Email, Mode=TwoWay}" />
            </Grid>

            <Entry Placeholder="First name"
                Text="{Binding FirstName, Mode=TwoWay}" />
            <Entry Placeholder="Last name"
                Text="{Binding LastName, Mode=TwoWay}" />

            <Label 
                Text="Birth date" 
                TextColor="#557755" />

            <DatePicker Format="dd/MM/yyyy"
                Date="{Binding BirthDate, Mode=TwoWay}"
                TextColor="#39FF14"
                BackgroundColor="#1A1A1A" />

            <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10"> <!--password entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Lock}"
                       TextColor="#39FF14" VerticalOptions="Center" />

                <Entry Grid.Column="1"
                    Placeholder="Password"
                    IsPassword="{Binding IsPasswordHidden}"
                    Text="{Binding Password, Mode=TwoWay}" />

                <Button Grid.Column="2"
                    Text="{Binding PasswordToggleText}"
                    Command="{Binding TogglePasswordCommand}"
                    TextColor="#39FF14"
                    BackgroundColor="Transparent"
                    Padding="6,0"  />
            </Grid>

            <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10"><!--password confirm entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Lock}"
                       TextColor="#39FF14" VerticalOptions="Center" />

                <Entry Grid.Column="1"
                    Placeholder="Confirm password"
                    IsPassword="{Binding IsConfirmPasswordHidden}"
                    Text="{Binding ConfirmPassword, Mode=TwoWay}"/>
                
                <Button Grid.Column="2"
                    Text="{Binding ConfirmPasswordToggleText}"
                    Command="{Binding ToggleConfirmPasswordCommand}"
                    TextColor="#39FF14"
                    BackgroundColor="Transparent"
                    Padding="6,0" />
            </Grid>

            <Label Text="{Binding Message}"
                TextColor="{Binding MessageColor}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Button Text="Register"
                Style="{StaticResource MainButton}"
                Command="{Binding RegisterCommand}" />

            <Button Text="Already have an account? Login"
                Style="{StaticResource LinkButton}"
                Command="{Binding GoToLoginCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>