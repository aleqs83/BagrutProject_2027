<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helper="clr-namespace:BagrutProject_2027.Helper"
             x:Class="BagrutProject_2027.Views.RegisterPage"
             BackgroundColor="#0D0D0D"
             Title="RegisterPage">

    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#1A1A1A" />
            <Setter Property="TextColor" Value="#39FF14" />
            <Setter Property="PlaceholderColor" Value="#557755" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#39FF14" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#39FF14" />
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="BlackOpsOne" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12" MaximumWidthRequest="420">

            <Label Text="Create Account" FontSize="34" FontAttributes="Bold"
                TextColor="White" HorizontalOptions="Center" Margin="0,20,0,10" />

            
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><!--username entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Person_add_alt}"
                       TextColor="#39FF14" VerticalOptions="Center" />
                <Entry Grid.Column="1" x:Name="NameEntry" Placeholder="Username"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><!--EMAIL entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Email}"
                       TextColor="#39FF14" VerticalOptions="Center" />
                <Entry Grid.Column="1" x:Name="EmailEntry" Placeholder="Email (name@gmail.com)" Keyboard="Email" />
            </Grid>
            
            <Entry x:Name="PNameEntry" Placeholder="First name" />
            <Entry x:Name="FNameEntry" Placeholder="Last name" />

            <Label Text="Birth date" TextColor="#557755" />
            <DatePicker x:Name="BirthDatePicker" Format="dd/MM/yyyy"
                     TextColor="#39FF14" BackgroundColor="#1A1A1A" />

            <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10"> <!--password entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Lock}"
                       TextColor="#39FF14" VerticalOptions="Center" />
                <Entry Grid.Column="1" x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
                <Button Clicked="btnShowPassword1" Grid.Column="2" />
            </Grid>

            <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10"><!--password entery field with icons-->
                <Label Grid.Column="0" FontFamily="MaterialIcons" FontSize="26"
                       Text="{x:Static helper:IconFonts.Lock}"
                       TextColor="#39FF14" VerticalOptions="Center" />
                
                <Entry Grid.Column="1" x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
                <Button Clicked="btnShowPassword2" Grid.Column="2" />
            </Grid>

            <Label x:Name="MessageLabel" HorizontalOptions="Center" />

            <Button Text="Register" Style="{StaticResource MainButton}"
                 Clicked="OnRegisterClicked" />

            <Button Text="Already have an account? Login"
                 Style="{StaticResource LinkButton}"
                 Clicked="OnBackClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>